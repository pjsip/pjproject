# Generated by build/apple/build-xcframework.sh.
#
# CocoaPods Trunk goes read-only in December 2026; this spec does not need it.
# Consumers can point straight at the file:
#
#   pod 'PJSIP', :podspec => '@PODSPEC_URL@'
#
Pod::Spec.new do |s|
  s.name             = 'PJSIP'
  s.version          = '@VERSION@'
  s.summary          = 'Open source multimedia communication library (SIP, SDP, RTP, STUN, TURN, ICE).'
  s.description      = <<-DESC
                       PJSIP built for Apple platforms with TLS provided by the
                       Network framework rather than OpenSSL. DTLS-SRTP is not
                       available in this build. Codecs with patent or copyleft
                       encumbrance are excluded. Opus is included, and video is enabled
                       with H.264 through VideoToolbox.
                       DESC
  s.homepage         = 'https://www.pjsip.org'
  s.license          = { :type => 'GPL-2.0-or-later or commercial',
                         :text => 'See https://www.pjsip.org/licensing.htm' }
  s.author           = 'Teluu Ltd.'

  s.source           = { :http => '@URL@', :sha256 => '@CHECKSUM@' }

  s.ios.deployment_target = '@IOS_MIN_RAW@'
  s.osx.deployment_target = '@MACOS_MIN_RAW@'

  s.vendored_frameworks = 'PJSIP.xcframework'

  s.libraries    = 'c++'
  s.frameworks   = 'AVFoundation', 'AudioToolbox', 'CoreGraphics', 'CoreMedia', 'CoreVideo', 'Foundation', 'Metal', 'MetalKit', 'Network', 'QuartzCore', 'Security', 'VideoToolbox'
  s.ios.frameworks = 'OpenGLES', 'UIKit'
  s.osx.frameworks = 'AppKit', 'CoreAudio'
end
