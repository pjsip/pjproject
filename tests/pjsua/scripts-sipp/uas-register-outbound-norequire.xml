<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- Registrar without SIP outbound (RFC 5626) support, over TCP. The 200 -->
<!-- to the REGISTER offering outbound has no "Require: outbound", so the -->
<!-- refresh Contact must no longer carry reg-id or +sip.instance (#5159).-->

<scenario name="REGISTER refresh after 200 without Require: outbound">
  <!-- The first REGISTER must offer outbound, or the check on the       -->
  <!-- refresh below would pass without testing anything.                -->
  <recv request="REGISTER" crlf="true">
    <action>
      <ereg regexp="reg-id=" search_in="hdr" header="Contact:"
            check_it="true" assign_to="1"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Contact:]
      Expires: 10
      Content-Length: 0

    ]]>
  </send>

  <!-- The refresh, sent 5 seconds before the 10 seconds expire.         -->
  <recv request="REGISTER" crlf="true">
    <action>
      <ereg regexp="reg-id=|\+sip\.instance=" search_in="hdr"
            header="Contact:" check_it_inverse="true" assign_to="2"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Contact:]
      Expires: 10
      Content-Length: 0

    ]]>
  </send>

  <!-- The variables only carry the checks above.                        -->
  <Reference variables="1,2"/>

  <!-- definition of the response time repartition table (unit is ms)   -->
  <ResponseTimeRepartition value="10, 20, 30, 40, 50, 100, 150, 200"/>

  <!-- definition of the call length repartition table (unit is ms)     -->
  <CallLengthRepartition value="10, 50, 100, 500, 1000, 5000, 10000"/>

</scenario>
