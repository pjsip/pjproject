# SDP offer/answer tokens (pjmedia sdp parser)
"v=0"
"o=- "
"s="
"c=IN IP4 "
"t=0 0"
"m=audio "
"m=video "
"a=rtpmap:"
"a=sendrecv"
"PCMU/8000"
"PCMA/8000"
"RTP/AVP"
"RTP/AVPF"
# SIP URI tokens (pjsip uri parser)
"sip:"
"sips:"
"@"
";transport=udp"
";user=phone"
"127.0.0.1"
# SIP method and header tokens (sip parser, inv usage, 100rel, timer)
"SIP/2.0"
"INVITE"
"UPDATE"
"PRACK"
"BYE"
"application/sdp"
"Require: 100rel"
"Supported: 100rel"
"Supported: timer"
"Supported: update"
"Session-Expires: 90"
"Min-SE: 90"
"RSeq: "
"rack"
