mainmenu "pjlib-test on Zephyr"

config PJLIB_TEST_ARGS
	string "Arguments for pjlib-test: test names and options; empty runs every test"
	default ""
	help
	  Appended, split at spaces, to the "--ci-mode -w 0" the Zephyr build
	  always passes. "-h" lists the options.

# The kernel heap, where the threaded build takes its pthread stacks from:
# the threads of the ioqueue stress test, 4 on a board with less than 2 MB
# (ioq_stress_test.c) at 8 KB each, plus the handful of other test threads.
# native_sim sets its own in boards/.
config HEAP_MEM_POOL_SIZE
	default 65536 if PJPROJECT_THREADS

source "Kconfig.zephyr"
